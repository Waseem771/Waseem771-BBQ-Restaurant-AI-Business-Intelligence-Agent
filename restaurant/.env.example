# Copy to .env. Never commit the resulting file.
# Generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development
BBQ_DATA_DIR=./data
BBQ_DB_PATH=./data/bbq.db

# Required for production (32+ characters). Use a unique value per environment.
JWT_SECRET_KEY=replace_with_a_unique_48_character_secret_before_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# Browser requests use the Vite proxy locally and Nginx in Docker.
VITE_API_URL=/api
VITE_DEMO_MODE=false
DEMO_MODE=false

# AI is opt-in. Set one provider and its key to enable the assistant.
LLM_PROVIDER=off
GROQ_API_KEY=
ANTHROPIC_API_KEY=
