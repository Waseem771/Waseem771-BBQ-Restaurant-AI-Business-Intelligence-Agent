# Production Environment Configuration
# Copy this file to .env and update with your values
# IMPORTANT: Change all passwords and secrets before deploying!

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

DB_USER=bbq_user
DB_PASSWORD=change_this_secure_password_12345
DB_NAME=bbq_db
DATABASE_URL=postgresql://bbq_user:change_this_secure_password_12345@postgres:5432/bbq_db

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_URL=redis://redis:6379

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

APP_ENV=production
APP_DEBUG=false
APP_TITLE=BBQ Restaurant AI Business Intelligence

# ============================================================================
# SECURITY KEYS (Generate these!)
# ============================================================================

# Generate secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_generated_secret_key_here_change_this

# Generate JWT secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_generated_jwt_secret_here_change_this

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000

# ============================================================================
# API CONFIGURATION
# ============================================================================

API_VERSION=1.0.0

# Frontend API URL (used by browser)
VITE_API_URL=https://yourdomain.com/api

# Backend URL (internal)
BACKEND_URL=http://backend:8000

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@yourdomain.com

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

LLM_API_KEY=sk_your_api_key_here
EMBEDDING_API_KEY=your_embedding_key_here

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

SENTRY_DSN=https://your_sentry_key@sentry.io/your_project_id
DATADOG_API_KEY=your_datadog_key

# ============================================================================
# DOMAIN & SSL
# ============================================================================

DOMAIN=yourdomain.com
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ============================================================================
# NOTES
# ============================================================================

# 1. Generate secure passwords:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. Generate secret key:
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# 3. For production, use strong passwords (20+ characters)
#
# 4. Store this file securely - never commit to git
#
# 5. Use .env.local for local development
#
# 6. Use separate .env files for different environments
